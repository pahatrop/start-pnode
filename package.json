{
  "name": "start-pnode",
  "description": "Pnode agent",
  "version": "1.0.9",
  "author": "Pavel Tuhar <pahatrop@gmail.com>",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "pnode": "./dist/cli.cjs",
    "start-pnode": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/cli.cjs",
    "dist/cli.cjs.map",
    "dist/cli.mjs",
    "dist/cli.mjs.map",
    "dist/cli.d.ts",
    "dist/cli.d.mts",
    "dist/index.cjs",
    "dist/index.cjs.map",
    "dist/index.mjs",
    "dist/index.mjs.map",
    "dist/index.d.ts",
    "dist/index.d.mts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pahatrop/start-pnode.git"
  },
  "type": "commonjs",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "tunnel",
    "proxy",
    "cli",
    "typescript",
    "pnode",
    "ngrok",
    "localtunnel"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "commander": "^14.0.2",
    "dns2": "^2.1.0",
    "dotenv": "^17.2.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
